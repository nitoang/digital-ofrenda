# Cloudflare Pages reads this file. The same policy is applied by the tests, so a page that needs anything
# looser fails them. Turnstile (the human check on sign-in) is the only third party allowed.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
# Ofrendas are memorials, not web pages to be indexed. (The preview page at /s/ and the data at /ofrendas/ say the same themselves.)
/a/*
  X-Robots-Tag: noindex, nofollow
